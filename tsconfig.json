{
  "$schema": "https://raw.githubusercontent.com/TypeScriptToLua/TypeScriptToLua/master/tsconfig-schema.json",
  "include": ["src", "node_modules/@gamely/acai-jsx"],
  "compilerOptions": {
    "ignoreDeprecations": "6.0",
    "lib": ["es2022"],
    "outDir": "build",
    "jsx": "react",
    "jsxFactory": "std.h",
    "jsxFragmentFactory": "std.h",
    "types": [
      "./node_modules/@gamely/gly-cli/npm/gly-jsx/index.d.ts",
      "@typescript-to-lua/language-extensions"
    ],
    "paths": {
      "@gamely/gly-types": ["./node_modules/@gamely/gly-cli/npm/gly-types/index.d.ts"]
    },
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "rootDir": ".",
    "baseUrl": "."
  },
  "tstl": {
    "buildMode": "library",
    "luaTarget": "universal",
    "luaLibImport": "inline",
    "noImplicitGlobalVariables": true,
    "noImplicitSelf": true,
    "noHeader": true,
    "luaPlugins": [
      { "name": "@gamely/tstl-number" },
    ]
  }
}
